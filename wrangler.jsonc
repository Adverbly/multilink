{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multilinks",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "multilinks",
      // From `npx wrangler d1 create multilinks`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    // Subdomains are <name>.ROOT_DOMAIN. Local development uses localhost (see .dev.vars.example).
    "ROOT_DOMAIN": "multilinks.app",
    "PRICE_DISPLAY": "$5.99",
    "STRIPE_PRICE_ID": "price_REPLACE_ME",
    "EMAIL_FROM": "Multilinks <keys@multilinks.app>",
  },
  // Secrets (set with `npx wrangler secret put`): STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET, RESEND_API_KEY.
  //
  // Once the domain is on Cloudflare, serve the main site and every subdomain:
  // "routes": [
  //   { "pattern": "multilinks.app", "custom_domain": true },
  //   { "pattern": "*.multilinks.app/*", "zone_name": "multilinks.app" }
  // ],
}
